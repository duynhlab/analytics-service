# Export these values through your process environment; no dotenv loader.
HTTP_ADDR=127.0.0.1:8088
CLICKHOUSE_ADDR=localhost:9440
CLICKHOUSE_USER=analytics_read
CLICKHOUSE_PASSWORD=
# Optional private CA; TLS validates the configured host by default.
CLICKHOUSE_CA_FILE=
# Explicit local-only opt-out of ClickHouse TLS / HTTPS-only OIDC validation.
ANALYTICS_ALLOW_INSECURE_LOCAL=false
OIDC_STAFF_ISSUER=https://auth.duynhlab.dev/realms/duynhlab-staff
OIDC_STAFF_JWKS_URL=
OIDC_AUDIENCE=duynhlab-platform
LOG_LEVEL=info
# Shared pkg/obsx settings; supply an actual collector when enabling exports.
OTEL_SERVICE_NAME=analytics-service
TRACING_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_LOGS_ENABLED=false
PROFILING_ENABLED=false
OTEL_COLLECTOR_ENDPOINT=localhost:4318
