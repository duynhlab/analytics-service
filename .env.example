# Export these values through your process environment; no dotenv loader.
HTTP_ADDR=127.0.0.1:8088
CLICKHOUSE_ADDR=localhost:9440
CLICKHOUSE_USER=analytics_reader
CLICKHOUSE_PASSWORD=
# ClickHouse TLS is on unless CLICKHOUSE_TLS=false (in-cluster ClickHouse has
# no TLS listener; the deployment fences it with NetworkPolicy instead).
CLICKHOUSE_TLS=true
# Optional private CA; only valid with CLICKHOUSE_TLS=true.
CLICKHOUSE_CA_FILE=
# The issuer is the public realm URL. The JWKS URL is the in-cluster fetch path
# and may be http:// only for *.svc.cluster.local, loopback or a Compose name.
OIDC_STAFF_ISSUER=https://id.duynh.me/realms/duynhlab-staff
OIDC_STAFF_JWKS_URL=
OIDC_AUDIENCE=duynhlab-platform
LOG_LEVEL=info
# Shared pkg/obsx settings; supply an actual collector when enabling exports.
OTEL_SERVICE_NAME=analytics-service
SERVICE_VERSION=
TRACING_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_LOGS_ENABLED=false
OTEL_COLLECTOR_ENDPOINT=localhost:4318
# Pyroscope continuous profiling (pkg/obsx); endpoint required when enabled.
PROFILING_ENABLED=false
PYROSCOPE_ENDPOINT=
